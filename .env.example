# =========================
# VillageCoverage
# Environment Variables
# =========================

# -------------------------
# 공공데이터포털
# data.go.kr
# 실제 원천 갱신 시에만 필요. 체크인된 데모 fixture 사용에는 불필요.
# 같은 Service Key로 신청한 여러 OpenAPI 사용
#
# Python requests/httpx에서 사용할 경우
# 일반적으로 "Decoding 인증키"를 넣는 것을 권장
# -------------------------
DATA_GO_KR_SERVICE_KEY=

# -------------------------
# KOSIS
# live 통계 조회 시에만 필요. 키는 서버 전용.
# -------------------------
KOSIS_API_KEY=

# -------------------------
# Kakao Developers
# -------------------------

# 서버 전용
# 주소 검색 / 좌표 변환 / Kakao Mobility 길찾기
KAKAO_REST_API_KEY=

# 브라우저에서 Kakao Maps JS SDK 사용
# 공개되어도 되는 플랫폼 키지만 도메인 제한 필수
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# -------------------------
# Google Gemini
# 서버 전용
# -------------------------
GEMINI_API_KEY=

# Structured Output을 지원하는 저지연 기본 모델
GEMINI_MODEL=gemini-3.5-flash-lite


# =========================
# Application
# =========================

NODE_ENV=development

# Next.js
NEXT_PUBLIC_APP_NAME=VillageCoverage

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# 개발환경에서 Next.js가 호출할 FastAPI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# =========================
# Database
# =========================

VILLAGE_COVERAGE_DB=data/village_coverage.sqlite
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
