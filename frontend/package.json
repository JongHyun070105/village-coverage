{
  "name": "villagecoverage-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public-demo": "playwright test --config=playwright.public-demo.config.ts",
    "test:e2e:ui-regression": "playwright test --config=playwright.ui-regression.config.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:public-demo"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
